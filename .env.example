# Copy to .env and fill in. Never commit the real .env.

# Required. Base64-encoded HMAC key, at least 256 bits. Generate with: openssl rand -base64 48
APP_JWT_SECRET=

# Postgres password for docker compose (defaults to "postgres" for local use)
POSTGRES_PASSWORD=

# Comma-separated origins allowed to call the API directly.
# Not needed when the frontend proxies /api (nginx in docker compose, Vite dev server, Vercel rewrites).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: Google Sign-In (OAuth client ID). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# External APIs (defaults are public instances)
JUDGE0_URL=https://ce.judge0.com
NAGER_DATE_URL=https://date.nager.at
